{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"loka-chat-mirror-v1",
  "main":"cloudflare/worker.mjs",
  "compatibility_date":"2026-10-01",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"loka-mirror-accounts-v1","database_id":"0f2917b1-9286-415d-ba2e-7decff9c7232","migrations_dir":"cloudflare/migrations"}],
  "ratelimits":[{"name":"AUTH_LIMIT","namespace_id":"18780","simple":{"limit":60,"period":60}}]
}
